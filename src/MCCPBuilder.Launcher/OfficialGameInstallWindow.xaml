<Window x:Class="MCCPBuilder.Launcher.OfficialGameInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="650" Height="270" MinWidth="520" MinHeight="230"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Border Background="#0C131D" BorderBrush="#46566A" BorderThickness="1.5" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#58C271">
                        <TextBlock Text="M" Foreground="#07120B" FontWeight="Bold" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="正在准备 Minecraft" Foreground="#F4F7FB" FontWeight="SemiBold"
                               FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Margin="32,22,32,28">
                <TextBlock Text="从官方服务器安装游戏文件" Foreground="#F4F7FB"
                           FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="ActivityText" Text="正在读取版本清单…" Foreground="#C1CCDA"
                           Margin="0,12,0,20" TextWrapping="Wrap"/>
                <ProgressBar x:Name="InstallProgress" Height="16" Minimum="0" Maximum="100"
                             Foreground="#58C271" Background="#1A2532"/>
                <TextBlock x:Name="CountText" Text="准备中" Foreground="#91A1B5" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
