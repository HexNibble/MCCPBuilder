<Window x:Class="MCCPBuilder.Launcher.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Minecraft 登录"
        Width="640"
        Height="680"
        MinWidth="560"
        MinHeight="600"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#59B96A"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#69CA7A"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#469856"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7F9FC"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEB8C7"/>
        <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#E9151B24"/>
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#60718194"/>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="3,2"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#354353"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#3D5946"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    CornerRadius="9"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Path x:Name="DropDownArrow"
                                  Width="10"
                                  Height="6"
                                  Margin="0,0,15,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Data="M 1,1 L 5,5 L 9,1"
                                  Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform/>
                                </Path.RenderTransform>
                            </Path>
                            <ToggleButton Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Margin="0,6,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="280"
                                        Padding="4"
                                        CornerRadius="9"
                                        Background="#FA202936"
                                        BorderBrush="#758294A7"
                                        BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="#8192A7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="DropDownArrow"
                                        Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckBoxSurface"
                                Padding="2,1"
                                Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckIndicator"
                                        Width="20"
                                        Height="20"
                                        CornerRadius="5"
                                        Background="#151B24"
                                        BorderBrush="{StaticResource FieldBorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Path x:Name="CheckMark"
                                              Data="M 4,10 L 8,14 L 16,5"
                                              Stroke="#0B170D"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Visibility="Collapsed"/>
                                        <Border x:Name="IndeterminateMark"
                                                Width="10"
                                                Height="2"
                                                CornerRadius="1"
                                                Background="#0B170D"
                                                Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckIndicator"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckIndicator"
                                        Property="BorderBrush"
                                        Value="#DDE4EE"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckIndicator"
                                        Property="Background"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckIndicator"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="CheckIndicator"
                                        Property="Background"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckIndicator"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="IndeterminateMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CheckBoxSurface"
                                        Property="Opacity"
                                        Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBoxSurface"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#364150"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#08120B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="TextButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BFD5FF"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="FieldBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="1,0,0,7"/>
        </Style>
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDE4EE"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WindowButtonBorder"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WindowButtonBorder"
                                        Property="Background"
                                        Value="#354050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="WindowButtonBorder"
                                        Property="Opacity"
                                        Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseWindowButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D9434E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            CornerRadius="12"
            Background="#10151D"
            Padding="0"
            SnapsToDevicePixels="True"
            SizeChanged="WindowFrame_SizeChanged">
        <Border x:Name="WindowSurface"
                CornerRadius="12"
                Background="#10151D"
                SnapsToDevicePixels="True">
            <Grid x:Name="BackgroundRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Rectangle Grid.RowSpan="2" Fill="#72081018"/>

            <Grid Margin="14,4,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="26" Height="26">
                        <Image x:Name="LauncherIconImage"
                               Width="26"
                               Height="26"
                               Stretch="Uniform"/>
                        <Border x:Name="LauncherIconFallback"
                                CornerRadius="7"
                                Background="{StaticResource AccentBrush}">
                            <TextBlock Text="M"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#0B170D"
                                       FontSize="14"
                                       FontWeight="Bold"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#DDE4EE"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button ToolTip="最小化"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="MinimizeWindow_Click">
                        <Viewbox Width="14" Height="14">
                            <Grid Width="14" Height="14">
                                <Path Data="M 2,7 L 12,7"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square"
                                      SnapsToDevicePixels="True"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="MaximizeWindowButton"
                            ToolTip="最大化"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="ToggleMaximize_Click">
                        <Viewbox Width="14" Height="14">
                            <Grid Width="14" Height="14">
                                <Path x:Name="MaximizeWindowGlyph"
                                      Data="M 2.25,2.25 L 11.75,2.25 L 11.75,11.75 L 2.25,11.75 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Miter"
                                      SnapsToDevicePixels="True"/>
                                <Path x:Name="RestoreWindowGlyph"
                                      Data="M 4.25,2.25 L 11.75,2.25 L 11.75,9.75 M 2.25,4.25 L 9.75,4.25 L 9.75,11.75 L 2.25,11.75 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Miter"
                                      Visibility="Collapsed"
                                      SnapsToDevicePixels="True"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button ToolTip="关闭"
                            Style="{StaticResource CloseWindowButtonStyle}"
                            Click="CloseWindow_Click">
                        <Viewbox Width="14" Height="14">
                            <Grid Width="14" Height="14">
                                <Path Data="M 3,3 L 11,11 M 11,3 L 3,11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square"
                                      SnapsToDevicePixels="True"/>
                            </Grid>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="24,10,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="4,0,4,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="MINECRAFT LAUNCHER"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="LauncherTitleText"
                                   Text="Minecraft 登录"
                                   Margin="0,7,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="28"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="登录账户并启动你的游戏"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="12,6"
                            Margin="16,5,0,0"
                            VerticalAlignment="Top"
                            CornerRadius="14"
                            Background="#B92B3441"
                            BorderBrush="#6574889B"
                            BorderThickness="1">
                        <TextBlock x:Name="ChannelBadgeText"
                                   Text="正式通道"
                                   Foreground="#EAF0F7"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Padding="24,22"
                        CornerRadius="16"
                        Background="#E6181F29"
                        BorderBrush="#6B778799"
                        BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="登录方式"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="ProviderBox"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="ProviderBox_SelectionChanged"/>

                            <TextBlock Text="账号或游戏名"
                                       Margin="1,18,0,7"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <TextBox x:Name="UsernameBox"
                                         TextChanged="UsernameBox_TextChanged"/>
                            </Border>

                            <TextBlock Text="密码"
                                       Margin="1,18,0,7"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <PasswordBox x:Name="PasswordInput"
                                             PasswordChanged="PasswordInput_PasswordChanged"/>
                            </Border>

                            <Border Margin="0,18,0,0"
                                    Padding="14,12"
                                    CornerRadius="9"
                                    Background="#A8212A36">
                                <TextBlock x:Name="HintText"
                                           TextWrapping="Wrap"
                                           Foreground="#D0D8E4"
                                           LineHeight="21"/>
                            </Border>

                            <CheckBox x:Name="RememberLoginCheckBox"
                                      Content="记住账号并保持登录（不保存密码）"
                                      Margin="2,16,0,0"
                                      Click="RememberLogin_Click"/>

                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="ClearSavedLoginButton"
                                        Content="清除已保存的登录信息"
                                        Style="{StaticResource TextButtonStyle}"
                                        Margin="0,0,20,0"
                                        Click="ClearSavedLogin_Click"
                                        Visibility="Collapsed"/>
                                <Button x:Name="RegisterButton"
                                        Content="注册统一通行证"
                                        Style="{StaticResource TextButtonStyle}"
                                        Click="Register_Click"
                                        Visibility="Collapsed"/>
                                <Button x:Name="PurchaseMinecraftButton"
                                        Content="购买 Minecraft"
                                        Style="{StaticResource TextButtonStyle}"
                                        Margin="20,0,0,0"
                                        Click="PurchaseMinecraft_Click"
                                        Visibility="Collapsed"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ChannelSwitchButton"
                            Content="切换到测试版"
                            MinWidth="126"
                            Style="{StaticResource BaseButtonStyle}"
                            Visibility="Collapsed"
                            Click="ChannelSwitch_Click"/>
                    <Button Grid.Column="2"
                            Content="取消"
                            MinWidth="86"
                            Margin="10,0,0,0"
                            Style="{StaticResource BaseButtonStyle}"
                            Click="Cancel_Click"/>
                    <Button x:Name="LoginButton"
                            Grid.Column="3"
                            Content="登录并启动"
                            MinWidth="170"
                            Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            Click="Login_Click"/>
                </Grid>
            </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
